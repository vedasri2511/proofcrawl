# Copy to .env (never commit .env). Everything here is OPTIONAL.

# --- Optional LLM: any OpenAI-compatible endpoint -------------------------
# Without these, ProofCrawl uses its deterministic rule-based intent parser
# and extractive summariser, and everything still works.
# Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
# OpenAI:             LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# Ollama (local):     LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Limits (server-side caps) --------------------------------------------
PROOFCRAWL_MAX_PAGES_CAP=25
PROOFCRAWL_MAX_DEPTH_CAP=3
PROOFCRAWL_DEFAULT_PAGES=8
PROOFCRAWL_DEFAULT_DEPTH=2
PROOFCRAWL_CRAWL_BUDGET_S=60
PROOFCRAWL_HARD_TIMEOUT_S=90
PROOFCRAWL_MAX_CONCURRENT_RUNS=2

# Allow localhost/private hosts (set automatically by `python run.py --demo-site`)
PROOFCRAWL_ALLOW_PRIVATE_HOSTS=0
